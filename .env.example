# AI Security Gateway - Environment Configuration

# Server Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO

# Security & Audit Salt (must be changed in production)
GATEWAY_AUDIT_SALT=replace_with_a_secure_random_salt_for_prompt_hashing
GATEWAY_ADMIN_API_KEY=admin-secret-key-change-me

# Active Policy File (balanced.yaml or strict.yaml)
GATEWAY_POLICY_PATH=policies/balanced.yaml

# Provider Configuration
# Options: mock, gemini
LLM_PROVIDER=mock

# Gemini API Key (Required only if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional LLM-based prompt injection classifier
ENABLE_LLM_INJECTION_CLASSIFIER=false

# SQLite Audit Database Path
AUDIT_DB_PATH=gateway.db
